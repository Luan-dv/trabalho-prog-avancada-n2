<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Compila já com otimização máxima: com a compilação em camadas (padrão), o laço quente
         começa sem otimizar e a 1ª repetição de cada cenário sairia artificialmente lenta. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Simulador.Core\Simulador.Core.csproj" />
  </ItemGroup>

</Project>
