{
  // Copie este arquivo para "appsettings.json" (na raiz do repositório) e ajuste.
  // O appsettings.json fica fora do git porque contém a senha.
  "MySql": {
    "Host": "localhost",
    "Porta": 3306,
    "Usuario": "simulador",
    "Senha": "simulador_dev",
    "Banco": "simulador"
  },
  "Gravacao": {
    // Linhas de estado por comando INSERT (lote). Valores maiores = menos idas ao servidor.
    "LinhasPorInsert": 1000,
    // Linhas por transação antes de cada COMMIT (cada COMMIT força escrita do log em disco).
    "LinhasPorTransacao": 50000
  }
}
